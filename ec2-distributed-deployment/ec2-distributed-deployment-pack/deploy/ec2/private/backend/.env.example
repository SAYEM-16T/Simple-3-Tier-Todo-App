# Replace DB_PRIVATE_IP with the DB EC2 private IP
# Replace FRONTEND_PUBLIC_URL with http://<FRONTEND_PUBLIC_IP> or your ALB/domain URL
DB_HOST=DB_PRIVATE_IP
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:StrongPass@123@DB_PRIVATE_IP:5432/todo_db
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://FRONTEND_PUBLIC_URL
