# Backend runs in a private subnet in this mode.
# Use the DB private IP here.
# If your password contains '@', encode it as '%40' inside DATABASE_URL.
DB_HOST=DB_PRIVATE_IP
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:StrongPass%40123@DB_PRIVATE_IP:5432/todo_db
SECRET_KEY=change-this-secret-key-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://FRONTEND_PUBLIC_IP
